generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  nationality   String?
  city          String?
  arrivalDate   DateTime?
  languages     String    @default("[]")
  status        String    @default("NEWCOMER")
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  checklistItems    ChecklistItem[]
  placesAdded       Place[]
  hostedExperiences Experience[]
  storiesWritten    Story[]
  buddyAsNewcomer   BuddyMatch[]         @relation("Newcomer")
  buddyAsAmbassador BuddyMatch[]         @relation("Ambassador")
  rsvps             ExperienceAttendee[]
  guideComments     GuideComment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ChecklistItem {
  id          String   @id @default(cuid())
  userId      String
  category    String
  title       String
  description String?
  completed   Boolean  @default(false)
  order       Int
  guideSlug   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Place {
  id          String   @id @default(cuid())
  name        String
  category    String
  lat         Float
  lng         Float
  city        String
  country     String   @default("France")
  description String?
  addedById   String
  createdAt   DateTime @default(now())

  addedBy User @relation(fields: [addedById], references: [id])
}

model Experience {
  id          String   @id @default(cuid())
  hostId      String
  title       String
  description String
  city        String
  date        DateTime
  capacity    Int
  createdAt   DateTime @default(now())

  host      User                 @relation(fields: [hostId], references: [id])
  attendees ExperienceAttendee[]
}

model ExperienceAttendee {
  id           String   @id @default(cuid())
  experienceId String
  userId       String
  createdAt    DateTime @default(now())

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])

  @@unique([experienceId, userId])
}

model BuddyMatch {
  id           String   @id @default(cuid())
  newcomerId   String
  ambassadorId String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  newcomer   User @relation("Newcomer", fields: [newcomerId], references: [id])
  ambassador User @relation("Ambassador", fields: [ambassadorId], references: [id])
}

model Story {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  content   String
  tags      String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])
}

model Guide {
  id                String         @id @default(cuid())
  slug              String         @unique
  checklistCategory String
  title             String
  summary           String
  officialLinks     String         @default("[]")
  steps             String         @default("[]")
  tips              String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  comments GuideComment[]
}

model GuideComment {
  id        String   @id @default(cuid())
  guideId   String
  authorId  String
  content   String
  helpful   Int      @default(0)
  createdAt DateTime @default(now())

  guide  Guide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])
}
